# Adresse des ISHD-Proxys. Leer = /api/ishd (Vercel-Funktion). Webhoster: /api/ishd.php
# Lokal leer lassen: npm run dev stellt /api/ishd selbst bereit.
VITE_ISHD_API_URL=

# Endpunkt für die Laufschul-Anmeldung. Leer = /api/anmeldung. Webhoster: /api/anmeldung.php
# Lokal leer lassen: npm run dev gibt Anmeldungen nur in der Konsole aus.
VITE_ANMELDUNG_API_URL=
